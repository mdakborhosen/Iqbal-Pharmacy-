        },
        "indication": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "brandName",
        "genericName",
        "companyName",
        "strength",
        "dosageForm",
        "packSize",
        "unitPrice",
        "stripPrice",
        "therapeuticClass",
        "indication",
        "createdAt",
        "updatedAt"
      ]
    },
    "PriceWatch": {
      "title": "PriceWatch",
      "description": "Tracked medicine item for automatic price change monitoring and alerts",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "medicineId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "brandName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "genericName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        },
        "companyName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "strength": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "baselineUnitPrice": {
          "type": "number"
        },
        "currentUnitPrice": {
          "type": "number"
        },
        "targetAlertPrice": {
          "type": "number"
        },
        "notifyOnAnyChange": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "medicineId",
        "brandName",
        "genericName",
        "companyName",
        "strength",
        "baselineUnitPrice",
        "currentUnitPrice",
        "targetAlertPrice",
        "notifyOnAnyChange",
        "createdAt",
        "updatedAt"
      ]
    },
    "PriceAlert": {
      "title": "PriceAlert",
      "description": "Automatic notification record generated when a medicine price changes",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "medicineId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "brandName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "genericName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        },
        "companyName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "strength": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "oldUnitPrice": {
          "type": "number"
        },
        "newUnitPrice": {
          "type": "number"
        },
        "oldStripPrice": {
          "type": "number"
        },
        "newStripPrice": {
          "type": "number"
        },
        "changedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "dateStr": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30
        },
        "isRead": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "medicineId",
        "brandName",
        "genericName",
        "companyName",
        "strength",
        "oldUnitPrice",
        "newUnitPrice",
        "oldStripPrice",
        "newStripPrice",
        "changedBy",
        "dateStr",
        "isRead",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/shops/{shopId}": {
      "schema": { "$ref": "#/entities/Shop" },
      "description": "Pharmacy shop profile settings"
    },
    "/inventory/{itemId}": {
      "schema": { "$ref": "#/entities/InventoryItem" },
      "description": "Pharmacy medicine stock and batch tracking"
    },
    "/customers/{customerId}": {
      "schema": { "$ref": "#/entities/Customer" },
      "description": "Pharmacy customer ledger profiles and balances"
    },
    "/transactions/{transactionId}": {
      "schema": { "$ref": "#/entities/Transaction" },
      "description": "Daily sales, purchases, and customer due payment history"
    },
    "/staff/{staffId}": {
      "schema": { "$ref": "#/entities/StaffMember" },
      "description": "Owner and staff profiles for counter sales entry"
    },
    "/custom_medicines/{medId}": {
      "schema": { "$ref": "#/entities/CustomMedicine" },
      "description": "Custom or price-updated medicines added by the pharmacy"
    },
    "/price_watches/{watchId}": {
      "schema": { "$ref": "#/entities/PriceWatch" },
      "description": "Tracked medicines for price monitoring"
    },
    "/price_alerts/{alertId}": {
      "schema": { "$ref": "#/entities/PriceAlert" },
      "description": "Price change notifications and audit alerts"
    }
  }
}
