        },
        "brandName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "genericName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        },
        "companyName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "strength": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "dosageForm": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "packSize": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "purchasePrice": {
          "type": "number",
